# NetAtlas Environment Configuration
# Copy this file to .env and adjust variables as required

NETATLAS_ENV=production
NETATLAS_HOST=127.0.0.1
NETATLAS_PORT=5000
NETATLAS_DEBUG=False

# Database configuration
DATABASE_URL=sqlite:///data/netatlas.db

# Ingestion configuration
PEERINGDB_API_BASE=https://www.peeringdb.com/api
PEERINGDB_RATE_LIMIT_DELAY_SEC=1.0
CABLE_DATA_BASE_URL=https://www.submarinecablemap.com/api/v3

# Timeout & Security
REQUEST_TIMEOUT_SEC=30
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

